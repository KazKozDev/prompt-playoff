# Copy to .env only when a launcher or shell setup loads dotenv files.
# Leave unused providers blank. Never commit real credentials.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
TOGETHER_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=
FIREWORKS_API_KEY=
DEEPSEEK_API_KEY=

# Optional generic fallback for an OpenAI-compatible provider.
PROMPT_PLAYOFF_API_KEY=

# Optional engine defaults. Ollama works without an API key.
PROMPT_PLAYOFF_ENGINE_PROVIDER=ollama
PROMPT_PLAYOFF_ENGINE_MODEL=
PROMPT_PLAYOFF_ENGINE_BASE_URL=http://127.0.0.1:11434

# Optional tracing. Values may contain sensitive endpoint/account information.
PROMPT_PLAYOFF_TRACING=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=
