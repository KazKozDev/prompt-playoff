# Prompt Playoff Demo - 20 second professional CLI demo
Output assets/demo-cli.gif
Set FontSize 24
Set Padding 40
Set Framerate 12
Set Theme "Chalk"
Set Width 1200
Set Height 700

# Quick intro
Type "cd prompt-playoff && ./start.command"
Enter
Sleep 1

# Header
Type "echo '══════════════════════════════════════════════'"
Enter
Type "echo '  Prompt Playoff — Optimize Prompts for Local LLMs'"
Enter
Type "echo '══════════════════════════════════════════════'"
Enter
Sleep 0.5

# Workflow
Type "echo ''"
Enter
Type "echo '→ DESCRIBE → RECOMMEND → COMPILE → BENCHMARK → OPTIMIZE'"
Enter
Sleep 1

# Example
Type "echo ''"
Enter
Type "echo 'Task: Extract entities from text'"
Enter
Sleep 0.5

# Results
Type "echo ''"
Enter
Type "echo '★ Few-Shot Examples    — 87%'"
Enter
Type "echo '★ Chain-of-Thought     — 82%'"
Enter
Type "echo '★ Role Prompting       — 75%'"
Enter
Sleep 1.5

# Final
Type "echo ''"
Enter
Type "echo '✅ Visit http://localhost:8000'"
Enter
Sleep 2
